# Configuración del contenedor. Copiar como .env.docker y completar (no subir .env.docker al repositorio).

# Clave secreta de Django: generar una nueva y larga, por ejemplo con
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambiar-por-una-clave-larga-y-secreta
DEBUG=False

# Subdirectorio donde se publica (vacío si va en la raíz del dominio)
URL_PREFIX=/registro-civil

# Dominio por el que se accede, y su origen HTTPS
ALLOWED_HOSTS=dominio-de-prueba.itse.edu.ar,localhost
CSRF_TRUSTED_ORIGINS=https://dominio-de-prueba.itse.edu.ar
# True si el contenedor está detrás de un proxy con HTTPS que envía X-Forwarded-Proto
CONFIAR_PROXY_HTTPS=True

# Chatbot RegIna (opcional)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Correo saliente (opcional; sin EMAIL_HOST los correos solo se registran en el log)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# Base de datos: por defecto SQLite dentro del volumen. Para PostgreSQL:
# DATABASE_URL=postgres://usuario:clave@servidor:5432/registro_civil

# Procesos de Gunicorn
GUNICORN_WORKERS=3
